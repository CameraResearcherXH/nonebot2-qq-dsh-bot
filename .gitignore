# ============================================================
# 运行时数据：记忆、表情、语音、数据库、现场 —— 绝不提交
# ============================================================
data/
napcat/
plugins_backup/

# ============================================================
# 密钥：只提交 .env.example
# ============================================================
.env
.env.*
!.env.example

# 算力机配置：只提交 node.env.example
node.env
node.env.*
!node.env.example

# 算力机本地产物
local_temp/

# ============================================================
# Python / 虚拟环境
# ============================================================
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/

# ============================================================
# 备份 / 临时 / 日志
# ============================================================
*.working
*.bak
DIST_REPORT.md
# xray 本地运行时（34MB Windows 二进制，绝不进发行仓）
scripts/.xray_runtime/
*.old
*.orig
*.log
*.tmp
*.part
*.zip
*.tar
*.tar.gz
*.7z
