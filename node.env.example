# 自动生成：算力机配置模板（node.py 读取）。填好后改名为 node.env

# ==========================================================
#  算力机配置（node.py 启动时读取，改完要重启 python node.py）
#  ⚠️ 这个文件只在算力机生效，服务器 /app/.env 里写这些没用
# ==========================================================

# ==================== 1. 连接 ====================
# 和服务器共用的密钥，必须与服务器 .env 的 API_SECRET 一致
API_SECRET=
# 香港服务器地址（node.py 默认 127.0.0.1:8080，一般不用写）
#SERVER_IP=127.0.0.1
#SERVER_PORT=8080
# 可选：把 node.py 的 HTTP 流量走本地机场代理端口，加速「算力机↔香港服务器」跨境传输。
# 填机场客户端（Clash Verge 等）的混合端口，例如 http://127.0.0.1:7897
# ⚠️ 前提：客户端规则里必须 127.0.0.0/8 直连 + 香港服务器 IP 走香港节点，否则本地服务会被误代理。
#NODE_PROXY=http://127.0.0.1:7897

# ==================== 2. 混音 ====================
# 人声比伴奏高多少 dB。正数=人声更突出，负数=人声更靠后
#   +3  = 人声比伴奏大 3dB（默认，人声清晰）
#   -2  = 人声比伴奏小 2dB（伴奏更响，人声靠后一点）
MIX_VOCAL_OVER_INST_DB=-2
# 鼓单独乘的增益（0.7 = 鼓降到 70%，避免盖住人声）
MIX_DRUM_GAIN=0.7s
# 人声高频补偿（dB）。
#   0  = 不加（默认）。女声本来就亮，+3dB 会把「夹嗓子的尖」直接放大成刺耳，
#        而且它治不了「高音起不来」——那个是模型音域上限压的，不是高频不够。
#   +2~+3 = 确实闷、咬字不清时才开
MIX_VOCAL_TREBLE_DB=0

# ==================== 3. 翻唱成品格式 ====================
# 中间文件格式：mp3（快）/ wav（无损但慢）
COVER_WORK_FORMAT=mp3
COVER_WORK_BITRATE=320k

# ==================== 4. 语音版（QQ 语音消息）====================
# 语音版的**文件体积上限（MB）**，不是 dB！
#   超过就截到「唱完高潮」，码率保持 192k 不压
#   1  = 约 43 秒（58s 192k 是 1.33MB，会被截短）
#   2  = 约 85 秒（58 秒全放得下）
#   3  = 宽松，基本不截
#   3  = 90 秒 192k 约 2.2MB，放得下（服务器会下发 voice_max_mb，这里只是兜底）
COVER_VOICE_MAX_MB=3
# 语音版最长秒数（服务器下发优先；90 秒）
# 语音版裁剪长度（兜底值）。服务器下发 task["voice_max_sec"] 优先，
# 但两边都设 100 最保险 —— 用户 2026-11-12：算力机只剪 58s，发过去的文件就是 58s。
COVER_VOICE_MAX_SEC=100
COVER_VOICE_BITRATE=192k
# 发完截断版后问「要不要整首」，多久没回就自动删文件（秒）
COVER_FULL_TTL=600

# ==================== 5. 音高判定（判男女）====================
# 只用于判断这首歌是男声/女声/对唱，**不直接决定移调**
# 移调现在走下面的「音域对齐」，不看性别
F0_MALE_MAX=155
F0_FEMALE_MIN=185
F0_MIXED_LO=165
F0_MIXED_HI=235
# F0 分析的**时间预算（秒）**，不是「只看前 N 秒」。
# 会均匀采样到全曲 6 个位置，所以 100 秒也能摸到曲末的高音。
#   100 = 快（约 2~3 秒）且够准
#   330+ = 更准但慢（全曲分析）
F0_ANALYZE_SEC=100

# ==================== 6. RVC 音域对齐（核心）====================
# kiki.pth 实测能自然唱到的最高音（Hz）。这是校准出来的真值。
# ⚠️ 2026-11-12 定稿：**保持 550**。
#    用户实测「kiki 到 550Hz 就开始哑」—— 这是模型能力的硬边界，不能为了
#    「让高音不降」而往上加（那是拿哑换的）。我一度试过 570，撤回了。
#    550 时源 613Hz 超 11.5% > 触发闸 8% → 会降 1 半音（地板 180 拦住，成品 183-579）。
RVC_VOICE_F0_MAX=550
# 下限：kiki 还能**保持女声**的最低音（Hz）。低于这个会跌回男声/发虚。
# 原曲最低音低于它 → 整首歌往上移到「最低 = 这个值」，其他跟着上移。
# 135 = 用户实测「最完美的低声女声保持」（130 会跌男声）。
RVC_VOICE_F0_MIN=135
# 源**本来就是女声**时，「值得整首升调」的门槛（Hz）。
#   RVC 变调是整体移调，共振峰会跟着上移 —— 女声歌 +2 半音就「夹着嗓子、发尖」。
#   女声歌 110~150Hz 的低音本来就是女声的低音，不该为了凑 135 而抬。
#   只有低到 100 以下（真男声 / 分离残留的低频）才动。调大 = 更容易升调（更尖）。
RVC_VOICE_F0_FEMALE_FLOOR=100
# ===== 女声「降调」三道闸（用户 2026-11-12 定）=====
# 背景：RVC 变调是整体移调，共振峰跟着走 → 女声降调会「有点男声化」。
# ① 高音只超上限 <8% 就不降：情歌 563 vs 540 只超 4.3%，降 1 半音不值
RVC_VOICE_F0_FEMALE_DOWN_TRIGGER=0.08
# ② 降完低音不能低于这个值：高的哑就哑吧，低的必须保持女声
#    ⚠️ 别设 150：F0_MALE_MAX=155，降到 161 就已经偏男了（2026-11-12 真机）。
#    实测校准：梁静茹《情歌》不降调时成品 p1=146Hz「刚好是女声」。
#    但降到 171 那首听感「跟读内容似的」→ 用户 2026-11-12 定为 **180**。
RVC_VOICE_F0_FEMALE_DOWN_FLOOR=180
# 男声源变声后的成品低音地板（用户 2026-11-12：洋葱掉到男音了，男生歌最低必须 140Hz）。
# 混音时会用高通把这条线以下切掉（RVC 会输出次谐波伪影，光靠升调参数压不住）。
RVC_VOICE_F0_MALE_FLOOR=140
# ===== 男声升调：按中位对齐，不再按最低音抬到 135 =====
# 老逻辑 lo=75 要 +11 半音 → 尖（苏打绿《小情歌》）。用户经验「变 6 是地板，5 就男音」。
# 新逻辑：p50 对齐 RVC_MALE_TARGET_F0，再夹在 [RVC_MALE_MIN_SEMIS, 12]。
#   平凡之路 p50=135 → 7；小情歌 p50=146 → 5.4 → 夹到 6。
RVC_MALE_TARGET_F0=200
RVC_MALE_MIN_SEMIS=6
# ③ 女声最多降几个半音（降太多整体男声化）
RVC_VOICE_F0_FEMALE_MAX_DOWN=4
# 是否**总是**把原曲 max 对齐到 RVC_VOICE_F0_MAX：
#   false（当前）= 只在超上限时往下调，本来在范围内的歌**保持原调**
#                  实测这个听感最自然（true 会把低音歌升成很尖的女高音，不好听）
#   true         = 不管原曲高低都对齐 540（低音歌会 +17 半音，很尖）
RVC_VOICE_F0_ALIGN_MAX=false
# 高低音**都**超出模型音域、只能救一头时先救哪一头：
#   true （当前）= 保低音：低音抬到下限之上，高音顶破上限就顶破
#                  （女声还在，只是那几句紧/略破）
#   false        = 保高音：高音压回上限内，低音掉到下限以下 → 直接变回男声
RVC_PITCH_LOW_FIRST=true
# 变调在哪一步做：
#   rvc = 原声不动，半音数交给 RVC 内部变调（音色最好）
#   pre = 先用 ffmpeg 对 vocal 变调，再让 RVC pitch=0（共振峰一起移）
COVER_PITCH_MODE=rvc
# 精确对齐（浮点）：true 时走 pre 路径，成品 max 精确等于 RVC_VOICE_F0_MAX
# RVC 的 pitch 只吃整数半音，做不到精确，所以想要「设多少就是多少」才开这个
COVER_PITCH_EXACT=false
# 模型音区中心（0 = 自动取 min/max 几何中心），只在 MODE=center 时用
RVC_VOICE_F0_CENTER=0

# ==================== 7. 超时 ====================
RVC_TIMEOUT=1800
UPLOAD_TIMEOUT_BASE=300
UPLOAD_TIMEOUT_PER_MB=12
UPLOAD_TIMEOUT_MAX=3600
DOWNLOAD_TIMEOUT_READ=180

# ==================== 8. 语音识别 / 复盘模型 ====================
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# ==================== 9. IndexTTS2（群语音）====================
# ⚠️ 这里连不上 → 服务器直接降级云端 CosyVoice（听感就是「龙呼呼」）。
# 启动 node.py 时会打一行 `🎙️ IndexTTS … ✅端口在听 / ❌没人听`，一眼能看出通没通。
TTS_URL=http://127.0.0.1:7860/api/v1/tts
# TTS_URL 端口不通时，自动扫这些端口，谁在听就试谁
TTS_PORT_CANDIDATES=7860,7861,7862,8000,9880,5000
# IndexTTS 产物目录（node.py 从这里捞本次生成的最新 wav）
TTS_OUTPUT_DIR=E:/deepseek/IndexTTS2.0_v3/outputs
# 参考音（她的音色样本），不填默认用 local_temp/prompt_kki_cut.wav
# TTS_PROMPT_WAV=./local_temp/prompt_kki_cut.wav
# 合成完要不要再过一遍 RVC（保持 kiki 音色）
TTS_USE_RVC=true

# ==================== 10. 画图（ComfyUI 本地服务）====================
# ComfyUI 是独立 HTTP 服务，node.py 只当客户端。默认 127.0.0.1:8188，别对外暴露。
# 端口不通时，心跳 caps 会自动摘掉 draw，服务器那边 /画图 会直接回「画图离线」。
SD_API_URL=http://127.0.0.1:8188
# workflow 模板目录（API format JSON）。不填默认是 node.py 同目录下的 comfy_workflows/
# SD_WORKFLOW_DIR=E:/deepseek/qq-grok-bot/comfy_workflows
# 底模（models/checkpoints/ 里的文件名，改了 ComfyUI 里也要有）
SD_MODEL=NoobAI-XL-v1.1.safetensors
# 出图 + HiRes 全链超时（秒）。NoobAI 1024→1536 实测约 20~60 秒，留足余量
SD_TIMEOUT=600
# ===== 文生图默认参数（用户配方：DPM++ 2M SDE GPU / Karras / steps 32 / CFG 5.5）=====
SD_WIDTH=1024
SD_HEIGHT=1024
SD_STEPS=32
SD_CFG=5.5
SD_SAMPLER=dpmpp_2m_sde_gpu
SD_SCHEDULER=karras
# 质量前缀（用户配方：very aesthetic；保留 safe 防 NSFW）
SD_PROMPT_QUALITY=masterpiece, best quality, very aesthetic, absurdres, safe
# 负向（用户配方 + nsfw/furry 安全锁；lineart/sketch 是「干净线稿」风格，排除草图感）
SD_NEGATIVE=nsfw, nsfw content, explicit, worst quality, old, early, low quality, lowres, normal quality, jpeg artifacts, signature, username, watermark, logo, text, bad anatomy, bad hands, mutated hands, extra fingers, missing fingers, extra digit, fewer digits, cropped, blurry, out of focus, rough sketch, messy lines, unfinished, lineart, sketch, mammal, anthro, furry, ambiguous form, feral, semi-anthro
# ===== HiRes（4x-UltraSharp 放大后低 denoise 重采样）=====
SD_UPSCALER=4x-UltraSharp.pth
SD_HI_SCALE=1.5
SD_HI_STEPS=20
SD_HI_DENOISE=0.4
# ===== 以图绘图 =====
# 图生图（重绘）的 denoise：越大改动越多，0.55 是「保构图换风格」的常用值
SD_IMG2IMG_DENOISE=0.55
# ControlNet 强度（线稿/姿势/景深通用）
SD_CONTROL_STRENGTH=0.9
# ControlNet 模型文件名（models/controlnet/ 下）。
# 默认用 xinsir/controlnet-union-sdxl-1.0 promax（一个模型通吃线稿/姿势/景深）。
# 如果你分开下，把这三个改成各自的实际文件名。
SD_CN_LINEART=diffusion_pytorch_model_promax.safetensors
SD_CN_POSE=diffusion_pytorch_model_promax.safetensors
SD_CN_DEPTH=diffusion_pytorch_model_promax.safetensors

# ===== LoRA 常驻栈（所有画图任务自动叠加，最多 3 个）=====
# 格式：文件名:权重,文件名:权重（文件名必须是 models/loras/ 下的实际文件名）
# 触发词单独在 SD_LORA_TRIGGERS 配，node.py 会自动把触发词追加到正向 prompt 末尾。
# ⚠️ 文件名以你实际下载到 models/loras/ 里的为准，下完自己改。
# 用户 2026-11-16 配方：NOOB_EPSv1_detailer 0.7 + FlatColor 0.5 + Nnegrat 0.2（合计 1.4）
SD_LORAS=NOOB_EPSv1_detailer_by_vlnvk_v0_5.safetensors:0.7,FlatColor_Illustrious.safetensors:0.5,Nnegrat_2_5D_High.safetensors:0.2
# FlatColor 触发词 flat color；NOOB_EPSv1_detailer / Nnegrat 无明确触发词，靠权重生效
SD_LORA_TRIGGERS=FlatColor_Illustrious.safetensors=flat color
# 备用风格 LoRA（可选，不默认叠）：需要时加进 SD_LORAS，总权重建议 ≤1.5
#   加细节:      DetailTweakerXL.safetensors:0.5   触发词 add detail
#   光影氛围:    epi_noiseoffset.safetensors:0.5
#               触发词 dark studio, rim lighting, two tone lighting, dimly lit, low key


