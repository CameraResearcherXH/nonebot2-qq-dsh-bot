# 自动生成：密钥与私人名单已清空；普通参数保留当前值，按需修改。

# ==========================================================
#  QQ-Little-Whale-Bot 环境变量
#  改完必须 `docker compose up -d --force-recreate bot`（restart 不重读 env_file）
#  ⚠️ 这个文件有 sudo 权限，编辑用 `sudo nano .env`
# ==========================================================
# ==================== 1. 框架 ====================
DRIVER=~fastapi+~websockets
HOST=0.0.0.0
PORT=8080
#ONEBOT_ACCESS_TOKEN=mytoken123
# ==================== 2. 白名单 ====================
# 管理员 QQ（多个用 JSON 数组）
SUPERUSERS=
# 群白名单：多个用英文逗号
ALLOWED_GROUPS=
# 私聊白名单：留空 = 不允许私聊
ALLOWED_PRIVATE=
# ==================== 3. 主模型（DeepSeek）====================
BOT_MODE=api
#BOT_MODE=mock
# 当前登录的 QQ（NapCat 用；换号只改这一行）
NAPCAT_ACCOUNT=
# NapCat 掉线自动重登（可选）：腾讯把快速登录 token 作废时，不用再扫码。
#   · 只填一个就行；MD5 更安全（md5sum 你的密码，32 位小写）
NAPCAT_QUICK_PASSWORD=
#NAPCAT_QUICK_PASSWORD_MD5=
# 她的人格 ID —— 记忆 / 对话标签 / 「发给她的」判定里的「自己」都用它。
# ⚠️ 换号时**不要改这行**：改了等于换人，旧记忆就接不上了。
# （首次运行会落盘到 data/self_id.json，之后以落盘值为准；这里只是显式写死）
SELF_ID=
# 她以前登录过的号（逗号分隔）。旧号的发言、@、引用都算「她」，不算群友。
# 换号时把旧号加到这里，新号写 NAPCAT_ACCOUNT —— 记忆/称呼/白月光全部继续用。
SELF_ALIASES=
MOCK_REPLY=我是测试机器人，链路已通~
XAI_API_KEY=
XAI_BASE_URL=https://api.deepseek.com
XAI_MODEL=deepseek-chat
# ==================== 角色扮演模型（2026-11-23）====================
# 主聊天 / 工具循环：DeepSeek V4.1 Flash（API 模型名 deepseek-flash）。
# 三方判读/审核：deepseek-chat。GLM 只做视觉（见 13 区）。
ROLEPLAY_BASE_URL=https://api.deepseek.com
ROLEPLAY_MODEL=deepseek-flash
# 不写 = 复用 XAI_API_KEY
#ROLEPLAY_API_KEY=
# ---- 余额 / 用量（function calling: api_usage）----
# 她私聊问「还有多少钱 / 今天用了多少 token」时会调这个工具。
# · 余额：按 XAI_BASE_URL 判断 —— 含 deepseek 走 GET /user/balance；
#   api.x.ai 官方没有余额接口，只会回「查不到，去 console 看」。
# · 用量：供应商都没有公开的用量接口，所以本机按天记账（每次 call_llm 累加）。
#   只记聊天主链路，审核/状态压缩那些旁路不算。
# 记账文件（相对项目根）：
API_USAGE_FILE=data/api_usage.json
# 记账保留多少天
API_USAGE_KEEP_DAYS=60
# 查余额的超时（秒）
API_USAGE_TIMEOUT=8
# ---- /上传文件（把 QQ 文件下载到 data/，仅主人）----
# 发 /上传文件 → 3 分钟内把 QQ 的「文件」发过来 → 落到下面这个目录（按天分子目录）
UPLOAD_DIR=data/uploads
# 等文件的时间（秒），默认 180 = 3 分钟
UPLOAD_WAIT_SEC=180
# 单文件上限（MB）
UPLOAD_MAX_MB=200
# ==================== 4. 对话行为 ====================
# 群里必须 @ 她才回复
GROUP_NEED_AT=true
# 单条回复最多多少字（防刷屏）
# ⚠️ 2026-11-17 核对：这个值只在 services/config.py 里读出来，**没有任何地方用**
#    （真正生效的是 GROUP_MAX_HANZI / PRIVATE_MAX_HANZI，见第 18.1 区）。
#    留着只为兼容，改它不会有任何效果。
MAX_REPLY_CHARS=100
# 同一会话两次回复的最小间隔（秒）。20 = 她连发时也要隔 20 秒才说下一句
# ⚠️ diag_conversation 基线：她回的是 7~22 秒前那句话，群里早翻篇了。
#    测试群单独压到 4 秒（见下面 GROUP_CHAT_OVERRIDES），其他群不动。
REPLY_INTERVAL=6
# ---- 单群体验参数覆盖（测试群做 A/B 用）----
# 格式：群号:回复间隔秒:直接发字数阈值
#   100000021:4:45 = 测试群 4 秒接话、45 字内直接发（其他群一律 20 字内尽量）
# 多个群逗号分隔；不配 = 全部走上面的默认值。
# ⚠️ 只影响列出来的群；想回滚删掉这一行即可。
# 2026-11-18 用户确认：测试群是唯一例外；其他群 20 字内尽量，超过走合并转发。
GROUP_CHAT_OVERRIDES=100000021:4:45
# 群聊上下文带多少条（含时间戳）。
# 2026-11-12 用户要求：「每次回复前往前拉 10 条，重点关注艾特它/叫它的人」
# 冲她说的消息会在上下文里标 ⭐（chat._addressed_to_me）
MAX_GROUP_RECENT=16
# 连续多少轮没写记忆就提醒她一句
DIGEST_AFTER=8
# ---- 主动插话（没人 @ 她也可能接话）----
RANDOM_CHAT_ENABLED=true
RANDOM_CHAT_INTERVAL=900 # 插话冷却（秒）—— 所有群的默认值，单个群可在下面覆盖
RANDOM_CHAT_MIN_MSGS=5 # 至少几条真人消息才考虑插话
RANDOM_CHAT_PROB=0.08 # 插话的「外部频率」（嫌吵调小）
#   ⚠️ 2026-11-19 起它不再是「每个 tick 掷一次骰子」：
#   真正的放行由 services/view_frequency.py 决定（刚说过话会衰减、久没说话会恢复），
#   这个值只是那个惯性模型的「基准值」。冷却/每小时上限/最少条数仍然是硬闸门。
# ---- 单群插话频率覆盖（用户 2026-11-18）----
# 格式：群号:冷却秒:插话概率:每小时上限:最少几条消息
#   多个群用英文逗号分隔；第 2 项之后可省略。
# 例：100000021:60:1:60:2
#   = 测试群每 60 秒最多问一次模型、每小时最多 60 次、
#     群里有 2 条真人消息就考虑（不再要求关键词相关度）
# 概率给 1 = 每次都真的问模型，由它决定接话还是安静（用户 2026-11-18：
#   不要用正则猜意图，LLM 本身就是智能判断）。
# ⚠️ 被覆盖的群默认**关掉关键词相关度门槛**：接不接由模型自己判断
#    （"这条是在找我 / 我可以接一句 / 不关我事"），词表只给没覆盖的群兜底。
GROUP_INTERJECT_OVERRIDES=100000021:60:1:60:2
# ---- 免打扰时段（**只对群聊**）----
# 0-8 点群里静默（连 @ 都不回）。夜里群里只剩早晚安，她别去接。
# ⚠️ 私聊不受这个限制，24 小时随时能聊（用户 2026-11-11 要求）。
#    真想让私聊也静默：PRIVATE_SLEEP=true
SLEEP_HOUR_START=0
SLEEP_HOUR_END=8
PRIVATE_SLEEP=false
# 早晚安问候：用户 2026-11-16 要求关掉 —— 到点（0点/8点）安静，不再主动发早晚安。
# ⚠️ 2026-11-17：问候循环代码已整个删除，这行**不再生效**（留着只为对照，可删）。
GREETING_ENABLED=false
# 群聊里别人发纯「早安/晚安/睡了」这种，她不回（很多群夜里只剩这个，接了很吵）
#   有实质内容的照常回：「早安，今天那个 bug 修了吗」
SKIP_PURE_GREETING=true
# ==================== 5. 她能被怎么叫醒 ====================
# 共同词：所有人喊都算。**留空**（用户 2026-11-12：大肥鱼/小肥鱼误判太多，去掉）。
# 只认「人格名 + 每个人自己给她取的名字（bot_alias）」，不再有全局昵称。
ME_COMMON_NAMES=
# 黑名单：这些词永远不当唤醒词（**子串匹配**，所以「肥鱼」会连「大肥鱼」一起拦）。
# 用户 2026-11-12：肥鱼触发率太高，连 bot_alias 里带这两个字的也要剔掉。
ME_BLOCK_NAMES=肥鱼
# 人格名（小鲸鱼）是否也算全局唤醒词；false = 只认私人称呼
ME_USE_PERSONA_NAME=true
# 私人称呼（/改名 设置的 bot_alias）自动按 QQ 隔离，别人喊不算，不用配
# ==================== 6. 群消息发送限流 ====================
# QQ 硬限制：同一个群每分钟最多 10 条。留 1 条余量。
GROUP_SEND_LIMIT=9
# 配额满了最多等多少秒，超了就丢弃剩余气泡（免得整轮失败）
GROUP_SEND_MAX_WAIT=15
# ==================== 6b. 高刷消息队列清理 ====================
# 群里刷得快时，排队等回复的旧消息会一直堆着，等她一条条回完，回的全是几分钟前的旧话。
# 命中条件 → 清空待处理队列，只留「@ 我 / 喊我名字」的，其余丢掉（正在处理的不受影响）。
# 平时刷得不快 → 完全按原样一条条回，行为不变。
BURST_FLUSH_ENABLED=true
# 统计窗口（秒）
BURST_WINDOW_SEC=30
# 窗口内达到几条就清队列（含刚进来的这条）
BURST_MSG_COUNT=4
# ==================== 6c. 说话时机（2026-11-11 trace 复盘后加的）====================
# 被动识图走哪条决策链（2026-11-19 改成 llm 主导）：
#   llm（默认）= 识图只负责「看见」：图 → GLM/qwen 识图 → trace.moe 扫角色 →
#                把全部证据交给 DeepSeek，由她决定开口 / 调 stay_silent / 收表情包。
#   mentioned  = 老行为：只有喊了她名字才进回复队列（LLM 决策链根本不跑）。
#   always     = 更老的行为：每 VISION_COOLDOWN 秒就为一张图回一句（已被群友嫌烦过）。
#   ⚠️ 之前默认 mentioned，就是「老流程先决策、LLM 只能被动执行」的根源。
VISION_REPLY_MODE=llm
# llm 模式下每小时最多把几张图交给她「想」（防刷图烧 token；不是"该不该说"的判断）
VISION_LLM_MAX_PER_HOUR=12
# 表情包收不收：llm=她看完图自己决定（sticker_save）；auto=见到就收（老行为）
STICKER_DECIDE=llm
# 识图冷却（秒），只影响"识别频率"，不影响要不要开口
VISION_COOLDOWN=300
# 被群友嫌弃后静默多少秒（「真烦人」「能不能关了先」「闭嘴」等）
# 只压主动插话和图片回复；@ 她 / 喊名字仍然回
GROUP_MUTE_SEC=900
# ==================== 6d. 戳一戳次数屏蔽（2026-11-23）====================
# 同一个人 2 小时内戳她超过 3 次 → 第 4 次起不回、也不戳回，只记上下文；
# 过了 2 小时窗口自动恢复（滑动窗口，不是永久拉黑）。
POKE_MAX_PER_WINDOW=3
POKE_WINDOW_HOURS=2
# 重复回复拦截：同一会话 N 秒内、新回复和上一句相似度 ≥ RATIO 就不发
REPLY_DEDUP_SEC=60
REPLY_DEDUP_RATIO=0.72
# 群聊里角色卡最多注入多少字（0 = 不限，默认不限）
# ⚠️ 默认关着：人格是"原文直出"设计的，裁剪容易切掉底线规则。要开建议 ≥3000
PERSONA_GROUP_CHARS=0
# 同一张图 N 小时内只处理一次（群友复读同一张图，她不该再评一遍）
IMAGE_DEDUP_HOURS=24
# 操作性短指令不接（扫扫/来了/发一下/装这个）—— 那不是聊天，是群里互相配合做事
SKIP_OP_SHORT=true
# ==================== 6d. 识图速度 / 角色猜测 ====================
# 说明（具体开关都在第 12 区）：
# · 第4层「定向追问」已关（VISION_TARGETED_ASK=false）：多一次 VL 调用、慢，
#   而且角色猜测现在由第1层的识图模型直接给出（标「猜」），不用再问一遍。
# · 识图 prompt 现在要求一次输出「画面 + 可能的角色/作品（标猜）+ NSFW 标记」，
#   比让 DeepSeek 拿到干巴巴的画面描述再自己猜，又快又准。
# ==================== 7. TTS / 语音 ====================
# true = 优先算力机 indextts；false = 永远走云端 CosyVoice
USE_LOCAL_TTS=true
# 算力机多久没心跳算离线（秒）。太小会误判离线 → 语音降级云端
HEARTBEAT_TIMEOUT_SEC=90
# 主动插话的「文字气泡」随机转语音的概率（0 = 永远纯文字）
# ⚠️ 这段原来走 services.reply.reply_with_multimodal，内部 30% 概率直接调云端
#    CosyVoice → 绕过 indextts，听感就是「indextts 开着还是龙呼呼」。已改走 speak_voice。
RANDOM_CHAT_VOICE_RATE=0.3
# 群成员名册缓存（秒）
ROSTER_TTL=600
# ==================== 8. 翻唱 ====================
# 超过体积上限就截到「唱完高潮」，不压码率
COVER_VOICE_MAX_MB=3.0
COVER_SPLIT_WAIT_SEC=900
COVER_RVC_WAIT_SEC=900
# 语音版时长。用户 2026-11-12 要 100s。
# ⚠️ QQ 语音条本身约 60 秒上限，超过大概率发不出去 —— 服务器侧发送失败会自动
#    降级成「文件」发出去，所以这里照截不误。算力机读这个下发值，不用另改。
COVER_VOICE_MAX_SEC=100
COVER_VOICE_BITRATE=192k
# 变调策略（下发给算力机，需要 node.py 支持 pitch_policy 才生效）：
#   female_keep = 源是女声就永不降调（平调歌降调会男声化，用户 2026-11-12 要求）
#   auto        = 老行为（高音超上限就往下调）
COVER_PITCH_POLICY=female_keep
# 女声源允许超出模型上限多少比例还不降（0.10 = 540Hz 放宽到 594Hz）
COVER_PITCH_MAX_TOLERANCE=0.10
# 发完截断版后问「要不要整首」，多久没回就自动删文件（秒）
COVER_FULL_TTL=600
# F0 提取算法（决定「音高曲线」准不准，和 pitch 是两回事）
#   rmvpe   = 默认，快，但弱音/气声/句尾容易提取不稳 → 音高回落 → 「每句句尾下楼梯」
#   harvest = WORLD 的自相关法，对低音/浊音更稳（可以试，但可能慢、对噪声敏感）
#   crepe   = 神经网络最准。2026-11-12 起 **可以用了**：
#             算力机 runtime 已装 torchcrepe 0.0.24，且 infer/vc/pipeline.py 的
#             get_f0 白名单 + crepe 分支已补（原来只认 pm/rmvpe/fcpe，连 harvest 都没有）。
#             首次调用会联网下 full 权重；离线机器请用 harvest。
# 结论（2026-11-12 真机 A/B 定稿）：**用 crepe**。
#   《月声尽》实测同一段人声、同 pitch：
#     rmvpe 成品 p50=368Hz（理论 329，偏高 39）
#     crepe 成品 p50=342Hz（偏高 13）← 更接近理论值，提取更准
#   用户听感：「crepe 明显唱出来更好，没有那种下阶梯的感觉，也很自然」。
# → 句尾下楼梯的根因确认是 **rmvpe 在弱音/气声处 F0 提取失手**，不是变调算错。
RVC_F0_FEMALE=crepe
RVC_F0_MALE=crepe
# 低音区单独抬升（备用，默认关 —— 只有 `/翻唱 歌名 低音+2` 才生效）
# 为什么备用：主问题已被 crepe 解决；这个只用于个别「低音段还是偏男」的歌。
# ⚠️ 不能改成整首 +2：RVC 整体移调会把共振峰一起上移 → 高音哑、发尖。
COVER_LOW_LIFT_HZ=260
COVER_LOW_LIFT_FADE=40
# /测歌 上传模式
# 等待用户发音频文件的有效期（秒）
PROBE_UPLOAD_TTL=900
# 只分离+判定要等多久（秒）
PROBE_WAIT_SEC=900
# 带 ab（rmvpe/crepe 各跑一遍 RVC）要等多久 —— 两遍 RVC + Demucs，给足
PROBE_AB_WAIT_SEC=2400
# 女声变声参数（RVC 的「音色维度」，和 pitch 是两回事）
# rms_mix_rate：音量包络混合比例。0=用模型的（平），1=用原唱的（有起伏）。
#   ⚠️ 2026-11-12 实测：0.5 会让原曲一半的强弱起伏消失 →
#   「《月声尽》变出来如同念读，平平无奇，但原曲不是这样」。提到 0.8。
RVC_RMS_FEMALE=0.8
# protect：清音/气声保护。太低 → 气声被压扁 → 「又夹又哑」。0.33 → 0.45
RVC_PROTECT_FEMALE=0.45
# 男声同一套（苏打绿《小情歌》+6 捏嗓子，主要也是这两个值偏低）
RVC_RMS_MALE=0.8
RVC_PROTECT_MALE=0.45
# ==================== 9. 外部 API 访问（算力机/第三方）====================
COVER_API_KEYS=
API_SECRET=
# ==================== 10. 搜索 / 语音识别 ====================
TAVILY_API_KEY=
#SERPER_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ==================== 10.5 算力机 / 本机插件 / 改代码（2026-11-24）====================
# 算力机总开关：
#   1 = 走 node.py（画图 / 翻唱 / 语音 / 视频理解都排任务给算力机）
#   0 = 不加载本项目的 draw / song_cover，也不注册这些 function 工具；
#       画图/唱歌请把现成的 nonebot 插件放进 plugins/third（本机跑）。
#       例：/画图、/唱歌 由三方插件接管；她通过 [[TOOLS|搜:画图]] 找到它们的工具。
NODE_COMPUTE=1
# 改代码方式：
#   self_tool = 原来的「她自己写 Python 工具」（self_tool_write/run/file）
#   harness   = 接 DeepSeek Harness 会话（可以真的改仓库代码），self_tool 自动关闭
#   off       = 两个都不开
CODE_AGENT=self_tool
# Harness 桥（CODE_AGENT=harness 时生效；只有主人能用）
HARNESS_BACKEND=cli
# CLI 模板：{prompt} / {cwd} / {session} 会被替换。
# 例：HARNESS_CLI=dsh run --cwd {cwd} --session {session} --prompt {prompt}
HARNESS_CLI=
# 或者用 HTTP 后端：
HARNESS_URL=
HARNESS_TOKEN=
# 工作目录（相对项目根；也可写绝对路径）
HARNESS_CWD=.
# 是否带人格/心情/好感/白月光/相关记忆
HARNESS_CONTEXT=1
# 只有主人能触发（强烈建议保持 1）
HARNESS_OWNER_ONLY=1
# ==================== 11. 记忆 / 上下文预算 ====================
PROMPT_BUDGET=2200 # 上下文总字符预算
LOCAL_MEMORY_DAYS=30 # 本地只管 30 天内
LIBRARY_COOLDOWN=600 # 图书馆最短间隔
MAX_TOOL_TURNS=6 # 工具最多几轮（napcat_help→napcat_call 两段式，3 轮不够）
# ---- 思考预算：两档 ----
# 默认快速档（几秒开口），她写 [[DEEP|理由]] 才升级到深度档（60 秒 / 多翻几轮）
THINK_BUDGET_FAST=12 # 快速档秒数
THINK_BUDGET_SEC=60 # 深度档秒数
MAX_REQ_ROUNDS_FAST=2 # 快速档最多补几轮资料
MAX_REQ_ROUNDS=6 # 深度档最多补几轮资料
HISTORY_MAX=20 # 往上翻历史最多几条（防止一次把上下文拉爆）
MAX_BUBBLES=2 # 一条回复最多拆几个气泡（连发三条很烦）
# ==================== 11.5 NapCat 全量 API 工具 ====================
# 她能自己操作 QQ：发消息/撤回/改群名片/禁言/踢人/戳一戳/点赞/加好友/传文件/拉历史…
# 分类 + 按需给说明（napcat_help）+ 权限分级（危险操作会私聊问主人，/批准 编号 放行）
NAPCAT_TOOLS=true # 总开关
NAPCAT_TOOLS_IN_GROUP=true # 群聊也挂这两个 meta 工具（关掉=只在私聊能操作）
NAPCAT_TOOL_MAX_PER_MIN=20 # 每分钟最多调几次（防她自己刷）
NAPCAT_APPROVE_TTL=600 # 待主人批准的请求多久过期（秒）
TOOL_RESULT_MAX=1500 # 工具结果回填给模型的字数上限
# recall 返回的原文长度上限（复盘要全文时读 text_full）
RECALL_TEXT_MAX=600
# 复盘：每 2 天
REFLECT_DAY=*/2
# 归档：每月 1 号（≈30 天）
ARCHIVE_DAY=1
ARCHIVE_WINDOW_DAYS=30
# ==================== 12. 识图（四层策略）====================
VISION_VERIFY=true # 文本核验总开关
VISION_VERIFY_MAX_PER_HOUR=20 # 每小时文本核验上限
VISION_CACHE_MAX=800 # 图片指纹缓存多少张
# 第1层 trace.moe：动漫截图以图搜番（免费无 key，每天只有 100 次额度）
# ⚠️ 2026-11-19 放宽：原来 0.85 + 「≥3票且≥60%」两条同时满足才算命中，
#    实测 B 站截图（带字幕/弹幕）相似度常年在 0.72~0.88，一个月一次都没认出来。
#    现在三档：高置信(≥0.90 且≥2票) / 疑似(≥0.75) / 线索(更低，只列候选不当事实)
TRACE_MOE=true
TRACE_MIN_SIM=0.75 # 采信下限（低于它只当线索，不写记忆）
TRACE_STRONG_SIM=0.90 # 高置信线（可以当事实讲）
TRACE_SINGLE_SIM=0.95 # 单帧几乎完全一致 → 一票也采信
TRACE_MIN_VOTES=2 # 至少几票
TRACE_MIN_SHARE=0.35 # 最高票至少占前 10 条的几成
TRACE_FLAT_STD=10 # 纯色/极简图跳过线（灰度标准差）
TRACE_MAX_PER_DAY=80 # 每天最多调几次（官方 100）
# 第3层 GLM 视觉作为第二证据源（不是否决器）
GLM_VISION=true
# 第4层 定向追问：前三层没认出专名时，换成「这是谁」再问一次
VISION_TARGETED_ASK=false
# ==================== 13. GLM-4-Flash（参考1）====================
GLM_API_KEY=
GLM_MODEL=glm-5.3-flash # 文本参考1
GLM_VISION_MODEL=glm-4v-plus # 视觉（4s 出正文；5.3-flash 能读图但「始终思考」要 23s）
GLM_THINKING=false # 参考1 只要「说人话」，不用思考
GLM_MAX_TOKENS= # 开 thinking 时要调大（否则 content 为空）
# ==================== 14. 三方差分 / 另一只鱼 ====================
REFEREE_ENABLED=true # 总开关
# 事前参考：GLM 先答一遍塞进 DeepSeek 的 prompt，让它做最终决策
# GLM 只做视觉：关掉 GLM 文本参考1（2026-11-23 用户要求）
REFEREE_PREFLIGHT=false
PREFLIGHT_TIMEOUT=2.5 # GLM 超过这么久就不等，直接回
PREFLIGHT_MIN_CHARS=6 # 太短的消息不跑 preflight（省时间）
# 事后 diff
REFEREE_MIN_CHARS=12 # 我们的回复太短就不核对
REFEREE_MAX_PER_HOUR=60
# ==================== 15. 第三方插件（plugins/third/）====================
# 三方插件和自研插件物理隔离：plugins/ 是自研，plugins/third/ 是三方的。
# 加载靠 bot.py 里额外一行 nonebot.load_plugins("plugins/third")。
# ---- petpet（头像表情包）----
# ⚠️ 必须配 "/"：petpet 的触发是
#      re.match(rf"(?:{command_start})(?:{pattern})", seg_text)
#    默认 petpet_command_start 是 [""]（空前缀），只认「手枪 xx」这种不带前缀的写法；
#    发 /手枪 xx 时开头的 "/" 让正则不匹配 → petpet 不接。
#    而 chat 那边现在也拦了 "/" 开头 → 两边都不接，指令完全没反应。
#    配成 ["/"] 之后：/手枪 xx → 只有 petpet 接，干净。
#    想让「手枪 xx」也能触发就写 ["/", ""]，但那样 chat 会同时接话（双回复），不推荐。
PETPET_COMMAND_START=["/"]
# ---- petpet 动图体积上限（默认不限制，保持原画质）----
# 2026-11-13 实测：/复读 生成 50 帧 × 1079×1192 的 GIF，约 4.5~5 MB。
# NapCat 的 sendMsg 会 30 秒超时报 retcode=1200「Timeout: NTEvent ... sendMsg」，
# 但 NTQQ 那边还在传，**图最后是能到的**，只是慢 —— 不是失败，别当失败处理。
# 代码里已改成：大图超时只记日志、静默收工，不回退 base64（5MB→6.7MB 只会再超时一次）。
#
# 如果以后觉得等太久，可以打开下面两行让 save_gif 自动减帧+缩放：
#   utils.save_gif() 逻辑：超过 max_size → 帧数 > max_frames 先按比例减帧（duration 同步放大）
#                        → 还是超 → 尺寸 ×0.9 递归缩小
# 静态图模板（jpg，几十 KB）不受影响。
# PETPET_GIF_MAX_SIZE=1.5
# PETPET_GIF_MAX_FRAMES=30
# 「典中典」模板要把文字翻成日语再贴图，走百度翻译开放平台。
# 不配也能用：utils.translate() 会退化成原文（以前是直接 KeyError: 'trans_result'
# 被 anyio TaskGroup 包成 ExceptionGroup，日志里根本看不出是这个原因）。
# 申请地址 https://fanyi-api.baidu.com/ ，免费版够用。
BAIDU_TRANS_APPID=
BAIDU_TRANS_APIKEY=
# ---- pixivrank（P 站排行/搜图）----
# ⚠️ PIXR_LOCAL_PROXY 在插件里是**必填无默认**的 pydantic 字段，
#    不写会导致 ValidationError → 整个插件加载失败。可以留空。
PIXR_LOCAL_PROXY=
# 自建 rsshub（香港专线那台）。留空则用插件默认的 rsshub.app（公共实例常 403）
# ⚠️ 末尾不要带斜杠！代码是 f"{pixr_rsshub}/pixiv/ranking/{mode}"，
#    带斜杠会拼出 "http://127.0.0.1:1200//pixiv/ranking/day"（双斜杠），RSSHub 会 404。
PIXR_RSSHUB=http://127.0.0.1:1200
PIXR_RETRY=3
# ---- pixiv 网页版会话 cookie（/p站搜图 用，2026-11-14 新增）----
# 搜图接口 /ajax/search/artworks 需要一个 www.pixiv.net 的 PHPSESSID。
# 实测**匿名 cookie 就够**（访问一次 pixiv.net 服务端就会发一个），不必真登录账号；
# 所以这个值过期了也不要紧，重新跑一次脚本刷新即可。
# 拿法：sudo docker compose exec -it bot python scripts/pixiv_get_cookie.py
#       （或者 Kiwi Browser / 手机抓包，详见脚本头部注释）
# 只填值或填 `PHPSESSID=xxx` 都行，代码会自动补 name。
# 验证：python scripts/pixiv_get_cookie.py --test "PHPSESSID=xxx"
PIXR_COOKIE=
# ---- RSSHub 的 pixiv 登录态（已停用，2026-11-13）----
# 现在 pixivrank 直连 https://www.pixiv.net/ranking.php?format=json，
# 不需要 RSSHub、也不需要登录态，rsshub 服务已从 docker-compose.yml 移除。
#
# 这个变量只有在「网页接口挂了、手动把 rsshub 加回来应急」时才有意义。
# 但注意：现在拿不到 token ——
#   · 账号密码授权被 pixiv 关闭（code 1508）
#   · PKCE 签发 code 的 /start 接口 404 已下线
#   · RSSHub 不支持 cookie
# 所以留空即可。
PIXIV_REFRESH_TOKEN=
# ---- BitTorrents（磁力搜索）----
# 主站 + 备用镜像（BT_MIRRORS 逗号分隔，主站挂了自动切下一个）
BT_BASE_URL=
# 合并转发节点显示的身份（不要用发送者本人的 QQ/昵称，见 main.py:_get_sender_info）
# uin=0 会被 QQ 渲染成默认/匿名头像
BT_FORWARD_UIN=0
BT_FORWARD_NAME=磁力搜索
BT_MIRRORS=
BT_MAX_RESULTS=3
BT_TIMEOUT=15
# ---- steam_judger（Steam 游戏库毒舌点评）----
# 出图要 Selenium + Chrome/chromedriver。
# 没装时插件会自动退回**纯文本**发送分析结果（不会像以前那样报「分析失败」把内容丢掉）。
STEAM_CHROMEDRIVER=
# Steam Web API Key，申请：https://steamcommunity.com/dev/apikey
# 域名那栏随便填（Steam 不校验，填 localhost 即可），key 与域名无关。
# 一个账号只有一个 key；泄露了在同页点 Revoke 重新生成，旧的立刻失效。
STEAM_API_KEY=
# AI 用 GLM（OpenAI 兼容格式，插件不用改代码）
AI_API_KEY=
AI_API_BASE=https://open.bigmodel.cn/api/paas/v4/chat/completions
AI_MODEL=glm-4-flash
REFEREE_CTX_LINES=10 # 影子回答带几条上下文
# 群里那只鱼
PEER_GROUPS=100000017
PEER_QQS=2267107632
PEER_WAIT=90 # 我们答完等鱼多久
PEER_REPLY_PROB=0.15 # 偶尔接鱼一句的概率
PEER_REPLY_COOLDOWN=180 # 接鱼的冷却（秒），防连发时回好几次
PEER_MERGE_WINDOW=6 # 鱼连发多条时，静默几秒后合并成一条
PEER_MERGE_MAX=25 # 合并最长等多久
# ==================== 15. 对话落盘（周报用）====================
DIALOGUE_LOG=true
DIALOGUE_KEEP_DAYS=14 # 对话和图片保留天数
DIALOGUE_IMG_SIDE=800 # 图片压缩最长边
DIALOGUE_IMG_BYTES=204800 # 单图最大字节（200KB）
# 每次调 DeepSeek 的**完整输入+回复**落盘，给 scripts/trace_reply.py 做对比：
#   A = API 实际看到的内容  B = 她实际回的  C = 上帝视角前后各 20 条真实消息
# 排查「上下文为什么不对」全靠这个，默认开着（一天几百 KB）
LLM_TRACE=true
LLM_TRACE_DIR=data/llm_trace
LLM_TRACE_KEEP_DAYS=7 # trace 保留天数
LLM_TRACE_MAX_CHARS=60000 # 单次 prompt 超过这个字数打标记（不截断落盘）
# ---- 上下文按需化（2026-11-11 重构）----
# 短历史只取**当天**的 → 等于每天自动开一个新对话（旧记录不删，长期记忆还要用）
CHAT_HISTORY_DAILY=true
# 人设文件每天最多重新扫几次（改完人设不用重启容器，最多等 10 分钟生效）
PERSONA_MAX_RELOADS_PER_DAY=2
# ---- 多轮思考（回复不着急）----
# 已改成两档：THINK_BUDGET_FAST / THINK_BUDGET_SEC / MAX_REQ_ROUNDS_FAST / MAX_REQ_ROUNDS
# 统一在上面「思考预算：两档」那段配，这里不要再写一遍（重复宏自检会报错）。
# ---- 每日总结（0:05 跑，第二天新开对话时交接）----
DAILY_SUMMARY_KEEP_DAYS=14
DAILY_SUMMARY_MIN_MSGS=6
# ==================== 16. 表情包 ====================
# auto = 收到就立刻收（视觉模型自动打标签）
# ask  = 先暂存，等她说「收」才入库
# off  = 完全关闭
# ⚠️ 这一项原来在文件里写了两次（auto / ask），后者覆盖前者，实际生效 ask
STICKER_COLLECT_MODE=ask
# ==================== 17. 画图（Civitai LoRA 下载用）====================
# Civitai API token（civitai.com -> Settings -> API Keys）。
# 服务器端 scripts/setup_loras.py（容器内 /app/scripts/setup_loras.py）会读它，
# 下载 LoRA 时不用每次手输 --token。
CIVITAI_TOKEN=
# ==========================================================
# 18. 2026-11-17 补齐：代码在读、之前 .env 没写的变量
# ----------------------------------------------------------
# 全部按代码里的**默认值**写出来，写与不写行为完全一样，
# 只是从「藏在代码里」变成「可见可调」。想恢复默认删掉对应行即可。
# ⚠️ node.py（算力机）的配置不在这里，看 node.env。
# ⚠️ 注释一律写在上方单独一行 —— 行内注释在某些 compose 版本会被当成值。
# ==========================================================
# ---- 18.1 字数 / 上下文 / 节奏 ----
# 「直接发文字」的字数阈值：≤20 字直接发，>20 字自动走合并转发（不截断）
# ⚠️ 不是硬上限，别再靠调大它来「让话说完整」——长回复会自动转卡片。
# 群聊唯一例外是 GROUP_CHAT_OVERRIDES 里列出的测试群。
GROUP_MAX_HANZI=20
# 私聊同一条规矩：≤20 直接发，>20 走合并转发
PRIVATE_MAX_HANZI=20
# 系统长文（视频总结等）≥ 这个字数才做合并转发卡片
LONG_FORWARD_MIN=120
# 同一个人连发多条时，合并成一轮回复的等待窗口（秒）
MERGE_WINDOW=0.6
# 没有内存队列时（私聊 / 刚重启），从历史库补几条上下文
CHAT_HISTORY_TURNS=6
# 引用回复展开被引用原文的字数上限
QUOTE_MAX_CHARS=500
# 超过多少字算「长消息」（被短消息挤出窗口时要补回来）
CTX_LONG_MSG_CHARS=150
# 最多补回几条长消息
CTX_LONG_MSG_KEEP=3
# 补回时长消息保留多少字
CTX_LONG_MSG_CHARS_MAX=800
# 「短查询」窗口（秒）：这期间追问的短句当同一话题
SHORT_QUERY_WINDOW_SEC=120
# 私聊挂「正在输入」状态（NapCat set_input_status，群聊不发）
TYPING_STATUS=true
# 别人已经说收尾语（睡了/算了/先这样/拜拜/886）就不接
SKIP_CLOSING=true
# 历史对话总字数预算
HIST_TOTAL_BUDGET=3000
# 普通历史行 / 长历史行各保留多少字
HIST_LINE_BASE=80
HIST_LINE_LONG=500
# 多长算「长行」，按 HIST_LINE_LONG 的额度算
HIST_LONG_AT=150
# 本地 Qwen 压缩失败时，原文最多塞多少字给 DeepSeek
SUMMARIZE_FALLBACK_MAX=1200
# ---- 18.2 关注会话 / 记忆回访 / 心情 / 档案 ----
# 被 @ 之后继续关注几句（关注期内不一定每句都回，先判断是不是在跟她说）
FOCUS_FOLLOW_COUNT=3
# 关注会话多久没互动就退出（秒）
FOCUS_TIMEOUT=120
# 关注期内的三档判定：是 / 否 / 不确定 —— 只有明确「否」才不回
# （关掉 = 关注期内每条都回，额度照样兜底）
FOCUS_JUDGE_ENABLED=true
FOCUS_JUDGE_TIMEOUT=3
# 刚被 @ 完的第一条后续默认回（关掉 = 每条都要过模型判，更容易漏）
FOCUS_FIRST_FOLLOW_ALWAYS=false
# 连续判否几次就结束关注（防「一直跟着讲」；判否同时扣 1 条额度）
FOCUS_NEG_STREAK_STOP=2
# 记忆回访：把很久没提的旧事顺口提一句（提不提由她自己决定）
MEMORY_REVISIT=true
# 记忆至少多老才值得「回访」（太新的聊天里自然会提到）
MEMORY_REVISIT_AGE_DAYS=7
# 至少多久没被想起（防止连着几轮翻同一件旧事）
MEMORY_REVISIT_IDLE_DAYS=3
# 相处经历（bond 小记）保留天数
BOND_TTL_DAYS=60
# 全局心情对单个会话的影响比例（0 = 完全按会话隔离）
MOOD_GLOBAL_SHARE=0.35
# 心情最多同时记多少个会话（超了清最旧的）
MOOD_MAX_SESSIONS=50
# ---- 心情是「她自己写的一句话」，不是固定枚举 ----
# 她写 [[MOOD|被夸得有点飘，但还装作没事]] 或 [[MEMO|emotion:自由描述|text:…]]，
# 原话会存下来、下一轮 prompt 里直接用她的原话（不是「你现在心情不错」这种模板）。
# 原话多久失效（小时）：太旧的心情不该一直挂着，默认跟半衰期一致 = 12
MOOD_LABEL_TTL_HOURS=12
# 原话最多多少字
MOOD_LABEL_MAX=60
# ---- 心情判读（services/mood_judge.py，影子运行）----
# 她只写「感觉 + 心里话」，**数字交给第三方模型判**（她自己写数值一定会乱写）。
# 判读输入：她的原话 + 心理活动 + 最近 MOOD_JUDGE_CTX 条群聊；
# 输出：心情名词 + 阈值 -1.00~1.00（两位小数）。
# 现在只记不用（/测函数 心情 可对照），验证准了再切进行为链路。
MOOD_JUDGE_ENABLED=true
# 判读用的模型；不写 = 跟 SCENE_AUDIT_MODEL / XAI_MODEL 一样
MOOD_JUDGE_MODEL=deepseek-chat
MOOD_JUDGE_TIMEOUT=12
# 判读看最近几条群聊（和审核窗口同一个口径）
MOOD_JUDGE_CTX=8
# 同一个会话多久内只判一次（秒）
MOOD_JUDGE_MIN_INTERVAL=60
# 她**没主动写**心情时，多久用群聊重新判一次（秒）。0 = 只在她写的时候判
MOOD_JUDGE_REFRESH=300
# 判读结果在「记忆情绪权重」里有效多久（秒）
MOOD_JUDGE_FRESH_SEC=600
# 她没写 [[THINK]] 时，后台补一句心里话（max_tokens 60，只在缺失时调）
# 真机命中率只有 2/7，靠模型自觉不靠谱 —— 补一条才能保证「每句回复都有心理活动」
MOOD_THINK_BACKFILL=true
# 被动心情观察节流（秒）：群里有消息就让她「心里过一遍」，
# 就算她不回也判（服务内还有 MOOD_JUDGE_REFRESH 5 分钟兜底），避免「越冷越不判、越难回升」
MOOD_WATCH_SEC=60
# ---- 数值来源（2026-11-20）----
# true = 心情值（-100~100）只由第三方判读的 delta 决定；
#        她自己写的 emotion / 关键词只留「原话」，不再改数值。
# false = 老行为（自报情绪也改数值），只用于回滚排查。
MOOD_FROM_JUDGE=true
# 判读直接给「当前心情值」(-1.00~1.00)，没有 delta/增量。
# 这个系数只防「一次误判让语气突变」：新值 = 旧值 + (判读值-旧值) × SMOOTH
MOOD_JUDGE_SMOOTH=0.35
# 没指定人格时的默认人格名（Personality/*.txt 里的名字）
DEFAULT_PERSONA=小鲸鱼proplus
# ---- 18.3 识图 / 视频 ----
VISION_MODEL=glm-4v-plus
# 视觉主通道：glm（GLM_VISION_MODEL，2026-11-24 起默认）｜qwen（DashScope 兜底）
VISION_PROVIDER=glm
# 自己下载图片再压再传（false）；true = 只把 QQ 链接丢给视觉模型（见下方同名项）
VISION_TIMEOUT=40
# 图片最长边缩到多少（大图不缩会超时）
VISION_MAX_SIDE=1568
# 压缩后仍超过这个字节数只警告不阻断（4MB）
VISION_MAX_BYTES=4194304
# 优先把图片链接直传（省流量），失败再退回 base64
# 2026-11-24 改 false：自己下载再压（控制画质），链接只当兜底
VISION_USE_URL=false
# 端点 × 模型 × 载体 的总尝试次数上限（防一路试到天荒地老）
VISION_MAX_ATTEMPTS=6
# 视觉专用 key / 端点：留空 = 用 DASHSCOPE_API_KEY / DASHSCOPE_BASE_URL
#VISION_API_KEY=
#VISION_BASE_URL=
# 视觉模型候选表（逗号分隔）：留空用代码内置顺序（Qwen3.5-Flash → qwen-vl-max …）
#VISION_MODEL_CANDIDATES=
# 视频每几秒抽一帧
VIDEO_FRAME_INTERVAL=5
# 最多抽多少帧（视频太长会自动变稀）
VIDEO_MAX_FRAMES=60
# 字幕关键位置额外抽几张高清帧
VIDEO_MAX_KEY_FRAMES=
# 单帧描述保留多少字（喂给总结模型）
VIDEO_MAX_FRAME_DESC=100
# ---- 18.4 图书馆 Agent（算力机）/ 本地小模型 ----
# 容器是 host 网络模式，所以 127.0.0.1 就是宿主机
AGENT_BASE_URL=http://127.0.0.1:8001
AGENT_RECALL_ENDPOINT=/api/agent/recall
AGENT_QUERY_ENDPOINT=/api/agent/query
AGENT_REFLECT_ENDPOINT=/api/agent/reflection
# 检索（30 天以前的事）等多久；超时就当没查到，不拖慢聊天
AGENT_RECALL_TIMEOUT=6
# 复盘（写回算力机）的超时
AGENT_REFLECT_TIMEOUT=180
AGENT_REFLECT_QUEUE_TIMEOUT=600
# 本地 Qwen（Ollama）：压缩图片描述 / 长文本用
LOCAL_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
LOCAL_LLM_MODEL=qwen2.5:7b
# 语音转写 / 性别判定用的 Qwen-Audio 模型：留空用内置候选
#QWEN_AUDIO_MODEL=
# ---- 18.5 GLM / 表情 / 画图 / 自造工具 ----
GLM_TIMEOUT=30
#GLM_BASE_URL=
#GLM_MODEL_CANDIDATES=
# 表情库上限 / 清理缓冲 / 单标签软上限
STICKER_MAX=1000
STICKER_PRUNE_BUFFER=20
STICKER_TAG_SOFT_CAP=120
# 表情整理（重复/低质自动归档）
STICKER_CURATOR=true
CURATOR_TIMEOUT=60
# 「收表情」等待用户发图的有效期（秒）
STICKER_WAIT_TTL=300
# ---- 档案卡片 ----
# 档案图上「事情」显示最近几条（用户 2026-11-19：4 条太少，要 10 条）
PROFILE_CARD_EVENTS=10
# 左上角 QQ 头像：缓存目录 / 多久更新（天）/ 取多大
AVATAR_DIR=data/avatars
AVATAR_TTL_DAYS=7
AVATAR_PX=160
# ---- 群友档案挖掘（2026-11-20）----
# 以前群友档案只有群名片/别名，没有「简介/性格/事情」。这里让第三方模型
# 从他自己说过的话里提炼，攒够 PROFILE_MINE_MIN_MSGS 句挖一次。
PROFILE_MINE_ENABLED=true
PROFILE_MINE_MIN_MSGS=25
PROFILE_MINE_INTERVAL_H=20
PROFILE_MINE_SAMPLE=40
PROFILE_MINE_TIMEOUT=25
# 用哪个模型（留空 = MOOD_JUDGE_MODEL → XAI_MODEL）
PROFILE_MINE_MODEL=
# ---- /导入表情 复制模式：大图缩到多大 ----
# 从 data/uploads 导入时**自动复制**进 data/stickers/<标签>/（uploads 会被清），
# 顺便把长边 > STICKER_MAX_SIDE 的静态图缩小（GIF 不动，压了就没动画了）。
STICKER_SHRINK=true
STICKER_MAX_SIDE=512
DRAW_ENABLED=true
# 画图排队最多等多久（秒）
DRAW_WAIT_SEC=360
DRAW_MAX_CONCURRENT=2
# 负面提示词（含逗号，要用就取消注释并保持一行）
#DRAW_NEGATIVE=nsfw, nsfw content, explicit
# 自造工具（她写 Python 工具并自己跑）
SELF_TOOL_DIR=data/self_tools
# 写工具/跑工具的进度播报到聊天窗口
SELF_TOOL_ECHO=true
# 只允许主人用
SELF_TOOL_OWNER_ONLY=true
SELF_TOOL_SCOPE=private,group
# 单次执行超时（秒）
SELF_TOOL_TIMEOUT=60
# 子进程内存 / 文件大小上限
SELF_TOOL_MEM_MB=1536
SELF_TOOL_FSIZE_MB=200
# 工具读文件一次最多返回多少字
SELF_TOOL_READ_MAX=1500
# ---- 18.6 翻唱 / 点歌（机器人侧下发值；算力机侧看 node.env）----
# 网易云 API（点歌、伴奏搜索）
NETEASE_API=http://127.0.0.1:3000
COVER_MAX_CONCURRENT=2
COVER_SOURCE_LEVEL=exhigh
COVER_MP3_BITRATE=192k
# 发完截断版后，等用户说「要整首」多久（秒）
COVER_FULL_WAIT_SEC=1800
# 只跑一遍 RVC（不跑 ab 对比），省时间
COVER_SINGLE_STAGE=true
TARGET_VOICE_FEMALE=kikiv2
TARGET_VOICE_MALE=kikiv2
RVC_PITCH_FEMALE=12
RVC_PITCH_MALE=-12
RVC_INDEX_RATE_FEMALE=0.5
RVC_INDEX_RATE_MALE=0.5
RVC_TARGET_F0=220
RVC_VOICE_F0_MIN=130
RVC_VOICE_F0_MAX=880
RVC_PITCH_MIN=-24
RVC_PITCH_MAX=24
RVC_SAME_GENDER_MAX_SEMIS=3
# F0 提取的可信度下限（低于这个判为清音/噪声）
F0_PERIODICITY_MIN=0.45
# 语音生成总等待 / 取回超时（秒）
TTS_WAIT_TOTAL=240
TTS_PICKUP_TIMEOUT=40
# ---- 18.7 复盘 / 归档 / NapCat / 排查 ----
# 拿群里那只鱼多少秒内的消息做三方核对
PEER_WINDOW=240
REFLECT_WINDOW_DAYS=2
REFLECT_HOUR=20
REFLECT_MINUTE=0
ARCHIVE_HOUR=3
ARCHIVE_MINUTE=0
# NapCat 工具结果回填给模型的字数上限
NAPCAT_TOOL_RESULT_MAX=550
# napcat_help 是否返回完整说明（false = 精简，省 token）
NAPCAT_HINT_FULL=false
# 1 = 记录已废弃函数被谁调用（排查用，正常运行可设 0）
DEP_TRACE=1
# ---- 18.8 这些「不用配」（有回退或空值语义），列出来只为对齐 ----
# OWNER_QQ / ADMIN_QQS   —— 自动取 nonebot 的 SUPERUSERS，不用重复写
# COVER_API_KEY          —— 用上面的 COVER_API_KEYS（复数）就够
# DEEPSEEK_API_KEY       —— 自动回退 XAI_API_KEY
# SERPER_API_KEY         —— 现在走 TAVILY，不用；要用在第 10 区填
# XAI_PROXY              —— 国内直连 DeepSeek，不需要代理
# DAILY_SUMMARY_PATH     —— 默认 data/daily_summary.jsonl，不用写
# TZ                     —— 不设则跟随容器时区；要固定可写 Asia/Shanghai
# ==========================================================
#  已废弃（留着也不生效，删掉更干净）
#  MAX_HISTORY —— 历史轮次改由 MAX_GROUP_RECENT + PROMPT_BUDGET 控制
#  GREETING_ENABLED —— 早晚安问候循环已整个删除（2026-11-17），见上面第 4 区
# ==========================================================
#MAX_HISTORY=10
# ==========================================================
#  ⚠️ 下面是「算力机侧」配置，写在 E:\deepseek\compute_node\node.env
#     服务器 .env 里写这些**不会生效**（node.py 是另一个进程，读自己的 node.env）
#     这里只列出来方便对照，别在这边改
# ==========================================================
# --- RVC 音色模型音域（kiki.pth 能唱的范围，Hz）---
#RVC_VOICE_F0_MIN=130
#RVC_VOICE_F0_MAX=880
#RVC_VOICE_F0_CENTER=0        # 0 = 自动取 min/max 几何中心
#RVC_PITCH_MIN=-24
#RVC_PITCH_MAX=24
# --- 变调在哪一步做 ---
# rvc = 原声不动，半音数交给 RVC 内部变调（默认，通常更自然）
# pre = 先用 ffmpeg 把 vocal 整体变调，再让 RVC pitch=0（共振峰一起移，音色会变）
#COVER_PITCH_MODE=rvc
# --- 音高判定阈值（算力机测 F0 用）---
#F0_MALE_MAX=155
#F0_FEMALE_MIN=185
#F0_MIXED_LO=165
#F0_MIXED_HI=235
#F0_ANALYZE_SEC=45            # 分析前多少秒（越长越准）
# --- 混音 ---
#MIX_VOCAL_OVER_INST_DB=3     # 人声比伴奏高多少 dB
#MIX_DRUM_GAIN=0.7            # 鼓单独乘的增益
#MIX_VOCAL_TREBLE_DB=3        # 人声高频补偿（治高音起不来）
# --- 工作格式 ---
#COVER_WORK_FORMAT=mp3        # 中间文件格式（wav = 无损但慢）
#COVER_WORK_BITRATE=320k
# --- 超时 ---
#RVC_TIMEOUT=1800
#UPLOAD_TIMEOUT_BASE=300
#UPLOAD_TIMEOUT_PER_MB=12
#UPLOAD_TIMEOUT_MAX=3600
#DOWNLOAD_TIMEOUT_READ=180
# --- TTS（算力机侧）---
#TTS_ENGINE=indextts
#TTS_URL=http://127.0.0.1:7860/api/v1/tts
#TTS_USE_RVC=true
#TTS_RVC_PITCH=0
#TTS_TIMEOUT=300
# ============================================================
# 19. 原神面板出图（gspanel + nonebot-plugin-htmlrender）
# ============================================================
# 容器里以 root 运行，Chromium 必须关沙箱，否则 playwright 启动直接报 sandbox 错。
# 参数按空格切分（htmlrender 内部 split()），不要加引号。
HTMLRENDER_BROWSER=chromium
HTMLRENDER_BROWSER_ARGS=--no-sandbox --disable-dev-shm-usage
# ============================================================
# 20. 群聊现场 / 词条 / 收件人审核（2026-11-19）
# ============================================================
# ---- 群聊现场 · 词条库（services/lorebook.py）----
# 只扫最近几条消息里的关键词（提到才注入，平时不占 token）
LORE_SCAN_DEPTH=4
# 历史前「群设定」最多多少字；超了按 order 丢
LORE_BUDGET=520
# 当前消息前「这条相关的设定」最多多少字
LORE_BUDGET_POST=260
# 每个群最多存多少条词条；超了先丢 order 最低、最久没更新的
LORE_MAX_ENTRIES=200
# ---- 收件人审核 LLM（services/scene_auditor.py）----
# 硬逻辑判完「谁→谁」后，再开一个**不角色扮演**的 LLM 只做标注审核。
# 只审「大家/不确定/低置信」的消息；@/引用/称呼不审；失败自动退回硬逻辑。
# 不想多花这个 token 就设 false。
SCENE_AUDIT_ENABLED=true
# 审核用的模型；不写 = 跟 XAI_MODEL 一样。想更便宜就取消注释换成小模型。
SCENE_AUDIT_MODEL=deepseek-chat
# 单次审核超时（秒）；超时直接用硬逻辑结果
SCENE_AUDIT_TIMEOUT=6
# 每次最多把最近几条消息给审核看（含上下文）
# ⚠️ 窗口是**按条数**，不是按时间：群里 A 说完没人接、10 分钟后 B 才回，
#    按时间拉会把这两句拆开，审核 LLM 看到的就是两句莫名其妙的话。
# 20 是下限（代码里 max(20, 这个值)）：写小了不生效，只能往大写。
SCENE_AUDIT_MAX_MSGS=20
# 同一个群两次审核最少间隔（秒），防止每条消息都调一次
SCENE_AUDIT_MIN_INTERVAL=4
# ---- 群聊现场「看多少条来判断」----
# 线程视图（线程1 那几行）和硬逻辑（谁→谁、话题重合）都看最近这么多条，
# 和 SCENE_AUDIT_MAX_MSGS 对齐：用户 2026-11-19「应该同时看 20 条，
# 而不是现在的五六条」。
SCENE_WINDOW_MSGS=20
# 现场卡片上「线程1」最多画几句（其它线程固定 4 句）。写 20 = 跟窗口一样
SCENE_CARD_LINES=20
# ---- 群聊滚动总结（审核 LLM 顺手给，像 QQ 元宝总结）----
SCENE_SUMMARY_ENABLED=true
# 总结多久过期（秒）；有新消息或超过这个时间会重新总结
SCENE_SUMMARY_TTL=180
# 总结最多多少字
SCENE_SUMMARY_MAX_CHARS=160
# ---- 重启后补现场（services/group_scene.py）----
# 现场（线程/谁→谁）只活在内存里，一重启就空；以前重启后
# `/测函数 现场` 只剩「窗口 1 条」，审核也只看得到最后一句。
# 打开后：现场为空时按**条数**从 data/dialogue 补回最近 N 条（时间戳保留原值）。
# 注意是按条数、不是按天 —— 群安静两天，最近 24 条也照样补得回来。
SCENE_SEED_FROM_LOG=true
# 补回几条（默认跟 KEEP_MSGS 一致；审核窗口 20，补少了还是不够看）
SCENE_SEED_LIMIT=24
# 日志也是空的时候，多少秒内不重复读盘（避免每条消息都去扫一遍文件）
SCENE_SEED_RETRY=30
# ============================================================
# 21 区：说话时机 / 注意力 / 对话状态（2026-11-19，参考 MaiBot）
# ============================================================
# ---- 防抖等待（合并连发时等多久再处理）----
# 裸图（只有图没字）至少等这么久：图还没下载完就生成，模型只会回「图还没加载出来」
DEBOUNCE_BARE_IMAGE=4.0
# 同一个人续发 / 换人说话 / 在叫她（秒）
DEBOUNCE_SAME=1.2
DEBOUNCE_OTHER=0.5
DEBOUNCE_AT=0.8
# 整批等待上限，别无限等
DEBOUNCE_MAX=8.0
# ---- 注意力漂移（纯 prompt，改完重启生效）----
# subtle | active | scattered | wild | off
ATTENTION_DRIFT=active
# strict | balanced | loose
ATTENTION_ANCHOR=balanced
# reserved | natural | lively
ATTENTION_REACTION=natural
# ---- 对话状态压缩（把更早的对话压成 5 类状态，接上文用）----
CONV_STATE_ENABLED=true
# 不写就跟 XAI_MODEL 一样；想更便宜可以换个小的
#CONV_STATE_MODEL=
# 同一会话两次压缩的最小间隔（秒），别太频繁，费 token
CONV_STATE_MIN_INTERVAL=300
# 注入块最大长度（字）
CONV_STATE_MAX_CHARS=420
# ============================================================
# 22 区：表达学习（学「这个群 / 这个人怎么说话」）
# ============================================================
# 和词条(lorebook)的分工：词条是「知道什么」，这里是「怎么说话」。
EXPRESSION_ENABLED=true
# 每攒够多少条真人消息挖一次（每个群独立计数）
EXPRESSION_EVERY=40
# 同一个群两次挖掘的最小间隔（秒），防止连着调
EXPRESSION_MIN_INTERVAL=600
# 每个作用域（群 / 人）最多存多少条说法，超了丢最久没出现的
EXPRESSION_MAX_PER_SCOPE=30
# 不写就跟 XAI_MODEL 一样
#EXPRESSION_MODEL=
# ============================================================
# 23 区：沉默权 / 安静开关（CHAT_OFF / CHAT_ON）
# ============================================================
# 她可以自己决定「某个群 / 某个人」暂时不回（心情不好、想安静一会儿）。
# 安静期间**照常读消息、写记忆、更新心情**，只是不开口 —— 这就是"听到所有内容"。
# 实现：安静时 API 层强制 tool_choice=stay_silent，不是靠提示词祈祷。
# 状态存 data/chat_switch.json，重启不丢。
# 安静时是否仍然调用模型（true=字面行为，费 token；false=只记上下文，省钱）
CHAT_OFF_LLM=true
# 安静时有人直接 @ / 喊名字，给不给她「想回就回」的选择权（免得着急找不到她）
CHAT_OFF_ANSWER_WHEN_CALLED=true
# 单次安静最长多少小时（防止她忘了开回来；0=不限制）
CHAT_OFF_MAX_HOURS=72
# 状态文件（一般不用改）
#CHAT_SWITCH_FILE=data/chat_switch.json
# ---- 安静建议（只算不改状态：把信号给角色扮演 LLM，让她自己决定）----
# 开关。false = 完全不往 prompt 里塞「要不要安静」的建议
QUIET_ADVISOR_ENABLED=true
# 看「最近多久」的好感/心情走势（秒）。默认 30 分钟
QUIET_ADVISOR_WINDOW_SEC=1800
# 建议阈值（0~1）：低于这个分数就不说，免得每轮都在念
QUIET_PERSON_MIN=0.45
QUIET_GROUP_MIN=0.55
# 同一条建议多久内不重复（秒）
QUIET_ADVISOR_COOLDOWN_SEC=900
# 对方道歉/破冰后，多久内不再建议「对他安静」（给台阶）
QUIET_THAW_GRACE_SEC=1800
# 好感走势窗口（秒）：和安静建议共用的「最近」范围
AFFINITY_TREND_WINDOW_SEC=1800
# ============================================================
# 24 区：主动私聊（群里不做，群里走 RANDOM_CHAT_*）
# ============================================================
# 判据 = 心情 × 亲密度 × 注意力漂移档位；任何一条不过就不打扰：
#   静音中 / 今天次数到顶 / 冷却中 / 刚聊完 / 太久没聊 / 最后一句是她说的 / 不够熟
PROACTIVE_PRIVATE=true
# 每个人每天最多主动找几次
PROACTIVE_MAX_PER_DAY=2
# 同一个人两次之间至少隔几小时
PROACTIVE_COOLDOWN_H=6
# 多久没说话才值得主动找（小时）：太短像补刀，太长像诈尸
PROACTIVE_IDLE_MIN_H=2
PROACTIVE_IDLE_MAX_H=72
# 关系门槛：低于这个亲密度不主动私聊（陌生人收到私聊会很吓人）
PROACTIVE_MIN_INTIMACY=0.45
# 综合分门槛（心情×亲密度×漂移）
PROACTIVE_MIN_SCORE=0.9
# 不打扰时段（左闭右开，默认 1 点到 9 点）
PROACTIVE_QUIET_START=1
PROACTIVE_QUIET_END=9
# 多久评估一次（秒）
PROACTIVE_CHECK_SEC=600
# 演练：只打日志不发消息。
# ⚠️ 先保持 true 跑一天，用 /测函数 主动 看「她会想找谁」，确认名单/语气没问题再改 false。
PROACTIVE_DRY_RUN=true
# ============================================================
# 25 区：群聊工具精简
# ============================================================
# 群聊每轮都会把 scope 里带 group 的工具全挂上（实测 33 个 ≈ 2500 token），
# 工具越多她越容易乱挑、也越贵。私聊不受影响。
# 填法：逗号分隔的工具名（用 /测函数 链路 看现在挂了哪些）。
# 建议先屏蔽这些「重/少用」的：
#GROUP_TOOL_DENY=mytool_filebox,mytool_findfile,mytool_netprobe,mytool_readdir,mytool_recentfiles,mytool_ricelog,mytool_weather,self_tool_write,self_tool_run,self_tool_file,genshin_bind,genshin_unbind,genshin_panel,genshin_team,steam_judge
GROUP_TOOL_DENY=
# ---- 以图搜源：SauceNAO（插画/网图出处，免费 key）----
PICSEARCH_SAUCENAO_KEY=
# ==================== 10.6 模型自由搭配（2026-11-24）====================
# 每个角色都能单独选 provider + 模型，不用改代码：
#   <ROLE>_PROVIDER=deepseek|glm|qwen|xai|openai|custom|<自定义名>
#   <ROLE>_MODEL / <ROLE>_BASE_URL / <ROLE>_API_KEY
# 角色：ROLEPLAY 主聊天｜JUDGE 心情判读｜AUDIT 收发件人审核｜VISION 识图
#       EXPRESSION 说话风格｜CONV_STATE 对话状态｜PROFILE 档案挖掘
# 例 1：主聊天换 GLM（不写就用 deepseek-flash）
#ROLEPLAY_PROVIDER=glm
#ROLEPLAY_MODEL=glm-5.3-flash
# 例 2：识图换 DeepSeek V4 Flash
#VISION_PROVIDER=deepseek
#VISION_MODEL=deepseek-flash
# 例 3：两个 chat 检测用不同模型
#JUDGE_PROVIDER=qwen
#JUDGE_MODEL=qwen3-vl-plus
#AUDIT_PROVIDER=deepseek
#AUDIT_MODEL=deepseek-chat
# 例 4：自己的中转站
#PROVIDER_MY_BASE_URL=https://your-proxy/v1
#PROVIDER_MY_API_KEY=sk-xxx
#PROVIDER_MY_MODEL=deepseek-chat
#ROLEPLAY_PROVIDER=my
# 群聊观察范围：
#   full = 现状：所有群消息都进判定（她关注全部群聊）
#   lite = 省流：只观察/记录（白月光/心情照常），只有 @她 / 引用她 / 喊名字 /
#          收件人是她 才入队回复；接话时拉附近 8 条上下文 + 记忆；不主动插话。
#   ⚠️ 私聊不受影响。
GROUP_WATCH_MODE=full
